---
import { Picture } from 'astro:assets';
import lyricsShot from '~/assets/screenshots/lyrics_page.png';
import { GITHUB_URL } from '~/config/site';
import { format, getDict, type Locale } from '~/i18n';
import type { ReleaseInfo } from '~/lib/release';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  release: ReleaseInfo;
}

const { locale, release } = Astro.props;
const t = getDict(locale);

const ctaLabel = (os: string) => format(t.hero.ctaFor, { os });
const heroPalette = ['#5e2412', '#b5542a', '#1d0b08', '#d98d4c', '#5a1a2c'];

// Keep Latin words unbreakable; CJK lines stay whole so the couplet never splits.
const lines = t.hero.titleLines.map((line) =>
  locale === 'zh' ? [[...line]] : line.split(' ').map((word) => [...word]),
);
const count = (words: string[][]) => words.reduce((n, w) => n + w.length, 0);
// Running character index per word of the gradient line.
let running = 0;
const offsets = lines[1].map((word) => {
  const start = running;
  running += word.length;
  return start;
});
---

<section data-hero class="relative isolate overflow-hidden pt-36 pb-10 md:pt-44">
  <div data-hero-mesh class="absolute inset-x-0 top-0 -z-10 h-[118vh] min-h-[760px]" aria-hidden="true">
    <div class="hero-fallback absolute inset-0"></div>
    <canvas data-hero-canvas data-palette={JSON.stringify(heroPalette)} class="absolute inset-0 size-full opacity-0 transition-opacity duration-[1600ms] data-[ready]:opacity-100"></canvas>
    <div class="absolute inset-0 bg-[radial-gradient(120%_70%_at_50%_0%,transparent_0%,rgb(11_8_7/0.35)_55%,var(--color-ink-950)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-b from-transparent to-ink-950"></div>
  </div>

  <div class="container-x flex flex-col items-center text-center">
    <a
      data-hero-fade
      href={release.pageUrl}
      target="_blank"
      rel="noopener"
      class="group inline-flex items-center gap-2.5 rounded-full bg-white/[0.06] py-1.5 pr-3 pl-1.5 text-[0.8rem] text-paper/85 ring-1 ring-white/10 backdrop-blur-md transition hover:bg-white/[0.1]"
    >
      <span class="rounded-full bg-gradient-to-b from-[#fff1de] to-[#f2c58f] px-2.5 py-0.5 font-medium text-[#2a160a]">{t.hero.eyebrow}</span>
      <span class="font-mono">v{release.version}</span>
      <Icon name="arrow-right" size={13} class="transition-transform duration-500 group-hover:translate-x-0.5" />
    </a>

    <h1 class="font-display mt-9 text-[clamp(2.7rem,8.6vw,7.4rem)] leading-[1.02]" aria-label={t.hero.titleLines.join('')}>
      {
        lines.map((words, li) => (
          <span class:list={['block', li === 1 && 'italic']} aria-hidden="true">
            {words.map((chars, wi) => (
              <>
                {wi > 0 && ' '}
                <span class="inline-block whitespace-nowrap">
                  {chars.map((ch, ci) => (
                    <span
                      data-hero-char
                      class:list={['inline-block', li === 1 && 'warm-char']}
                      style={li === 1 ? `--i:${offsets[wi] + ci};--n:${count(words)}` : undefined}
                    >
                      {ch}
                    </span>
                  ))}
                </span>
              </>
            ))}
          </span>
        ))
      }
    </h1>

    <p data-hero-after class="mt-8 max-w-[38rem] text-[1.05rem] leading-relaxed text-soft md:text-lg">
      {t.hero.subtitle}
    </p>

    <div data-hero-after class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#download"
        class="btn btn-primary !h-[3.25rem] !px-7"
        data-os-cta
        data-href-windows={release.assets.windowsMsi.url}
        data-href-macos={release.assets.macArm.url}
        data-href-linux={release.assets.linux.url}
        data-label-windows={ctaLabel('Windows')}
        data-label-macos={ctaLabel('macOS')}
        data-label-linux={ctaLabel('Linux')}
      >
        <Icon name="download-simple" size={18} data-os-icon="none" />
        <Icon name="windows-logo" size={18} data-os-icon="windows" hidden />
        <Icon name="apple-logo" size={18} data-os-icon="macos" hidden />
        <Icon name="linux-logo" size={18} data-os-icon="linux" hidden />
        <span data-os-label>{t.hero.ctaDownload}</span>
      </a>
      <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn btn-ghost !h-[3.25rem] !px-6">
        <Icon name="github-logo" size={18} />
        {t.hero.ctaGithub}
      </a>
    </div>

    <p data-hero-after class="mt-6 flex items-center gap-3 text-[0.8rem] text-faint">
      <span>{t.hero.meta[0]}</span>
      <span class="size-1 rounded-full bg-white/25"></span>
      <span>{t.hero.meta[1]}</span>
    </p>
  </div>

  <div class="container-x mt-16 md:mt-24 [perspective:2200px]">
    <div data-hero-shot class="relative mx-auto max-w-[76rem] origin-[50%_0%] [transform-style:preserve-3d]">
      <div class="absolute -inset-x-[6%] top-[8%] -bottom-[10%] -z-10 rounded-[50%] bg-[radial-gradient(closest-side,rgb(240_140_80/0.38),rgb(150_40_60/0.18)_55%,transparent)] blur-3xl" aria-hidden="true"></div>
      <div class="overflow-hidden rounded-[clamp(0.75rem,1.6vw,1.4rem)] bg-ink-900 shadow-[0_50px_120px_-30px_rgb(0_0_0/0.85),0_0_0_1px_rgb(255_240_225/0.1)]">
        <Picture
          src={lyricsShot}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600, 1908]}
          sizes="(min-width: 1280px) 1216px, 92vw"
          alt={t.hero.screenshotAlt}
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { MeshGradient } from '~/scripts/mesh-gradient';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (canvas) MeshGradient.create(canvas, JSON.parse(canvas.dataset.palette!), { speed: 0.55, resolution: 0.35 });
</script>

<style>
  /* Each glyph carries its slice of one continuous gradient, so per-character
     transforms during the intro don't break background-clip: text. */
  .warm-char {
    background-image: linear-gradient(100deg, #fbe3bd 0%, var(--color-amber) 36%, var(--color-ember) 70%, var(--color-rose) 100%);
    background-size: calc(var(--n) * 100%) 100%;
    background-position: calc(var(--i) / max(var(--n) - 1, 1) * 100%) 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-inline-end: 0.04em;
  }
  .hero-fallback {
    background:
      radial-gradient(60% 50% at 25% 15%, #8a3d1c 0%, transparent 70%),
      radial-gradient(50% 45% at 80% 20%, #6b1f33 0%, transparent 70%),
      radial-gradient(70% 60% at 50% 60%, #3a160c 0%, transparent 70%),
      var(--color-ink-950);
  }
</style>
