---
import { Image } from 'astro:assets';
import icon from '~/assets/icon.png';
import Base from '~/layouts/Base.astro';
import { getDict } from '~/i18n';

const zh = getDict('zh').notFound;
const en = getDict('en').notFound;
---

<Base locale="zh" title={`404 — ${zh.title}`} noindex>
  <main class="relative isolate flex min-h-dvh items-center justify-center overflow-hidden px-6 text-center">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(50%_40%_at_50%_40%,rgb(224_100_60/0.22),transparent_70%)]"></div>
    <div>
      <Image src={icon} alt="Rustle" width={160} height={160} class="mx-auto size-20 rounded-[22px] animate-[spin_24s_linear_infinite]" />
      <p class="mt-10 font-mono text-sm tracking-[0.3em] text-faint">404</p>
      <h1 class="section-title mt-4">{zh.title}</h1>
      <p class="mt-4 text-soft">{zh.body}</p>
      <p class="mt-1 text-sm text-faint">{en.title} — {en.body}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">{zh.back}</a>
        <a href="/en/" class="btn btn-ghost">{en.back}</a>
      </div>
    </div>
  </main>
</Base>
