---
import { icons } from '@iconify-json/ph';
import { getIconData, iconToSVG, replaceIDs } from '@iconify/utils';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  /** Phosphor icon name, e.g. `windows-logo` or `play-fill`. */
  name: string;
  size?: number | string;
  label?: string;
  hidden?: boolean;
}

const { name, size = '1em', label, ...rest } = Astro.props;
const data = getIconData(icons, name);
if (!data) throw new Error(`Unknown Phosphor icon: ${name}`);
const { attributes, body } = iconToSVG(data);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={attributes.viewBox}
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}
  set:html={replaceIDs(body)}
/>
