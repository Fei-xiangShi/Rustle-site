---
import { Image } from 'astro:assets';
import blueHour from '~/assets/covers/blue-hour.jpg';
import leaves from '~/assets/covers/leaves-in-motion.jpg';
import { songs, type CoverKey } from '~/data/lyrics';
import { getDict, type Locale } from '~/i18n';
import Icon from './Icon.astro';
import Phrases from './Phrases.astro';

interface Props {
  locale: Locale;
}

const t = getDict(Astro.props.locale);
const demo = t.lyrics.demo;
const first = songs[0];
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
const coverImages: Record<CoverKey, ImageMetadata> = { leaves, blueHour };
// AMLL's background samples the cover itself, so it gets the source URLs.
const coverUrls = Object.fromEntries(Object.entries(coverImages).map(([k, img]) => [k, img.src]));
---

<section id="lyrics" aria-labelledby="lyrics-title" class="relative py-24 md:py-36">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-end">
      <div>
        <p data-reveal class="kicker">{t.lyrics.kicker}</p>
        <h2 id="lyrics-title" data-reveal class="section-title mt-6"><Phrases text={t.lyrics.title} /></h2>
        <p data-reveal class="mt-7 max-w-xl text-lg leading-relaxed text-soft">{t.lyrics.body}</p>
      </div>
      <dl class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
        {
          t.lyrics.points.map((p) => (
            <div data-reveal class="border-t hairline pt-5">
              <dt class="font-medium">{p.title}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-faint">{p.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div
      data-reveal
      data-lyrics-demo
      data-covers={JSON.stringify(coverUrls)}
      class="lyrics-demo surface relative mt-16 overflow-hidden !rounded-[clamp(1.25rem,2.4vw,2rem)] md:mt-20"
    >
      <div class="demo-fallback absolute inset-0" aria-hidden="true"></div>
      <div data-bg class="absolute inset-0" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(8_5_4/0.35),rgb(8_5_4/0.12))]" aria-hidden="true"></div>

      <div class="relative grid h-full grid-rows-[auto_minmax(0,1fr)] gap-6 p-5 sm:p-8 md:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] md:grid-rows-1 md:gap-10 md:p-12 lg:p-14">
        <div class="flex flex-row items-center gap-5 md:flex-col md:items-stretch md:justify-center">
          <div class="cover-stack relative aspect-square w-20 shrink-0 overflow-hidden rounded-xl shadow-[0_24px_60px_-20px_rgb(0_0_0/0.8)] ring-1 ring-white/10 sm:w-24 md:w-full md:max-w-[19rem] md:rounded-2xl">
            {
              songs.map((song, i) => (
                <div data-cover data-active={i === 0 ? '' : undefined} class="cover absolute inset-0">
                  <Image src={coverImages[song.cover]} alt="" width={480} height={480} class="size-full object-cover" />
                </div>
              ))
            }
          </div>

          <div class="min-w-0 flex-1 md:mt-7 md:max-w-[19rem] md:flex-none">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p data-title class="truncate text-lg font-semibold md:text-xl">{first.title}</p>
                <p data-artist class="mt-0.5 truncate text-sm text-white/60">{first.artist}</p>
              </div>
              <button type="button" class="mt-1 hidden text-rose md:block" aria-label={demo.like}>
                <Icon name="heart-fill" size={20} />
              </button>
            </div>

            <div
              data-track
              role="slider"
              tabindex="0"
              aria-label="Progress"
              aria-valuemin="0"
              aria-valuemax={Math.floor(first.duration)}
              aria-valuenow="0"
              class="group mt-4 cursor-pointer py-2"
            >
              <div class="h-1 overflow-hidden rounded-full bg-white/20 transition-[height] group-hover:h-1.5">
                <div data-fill class="h-full w-full origin-left rounded-full bg-[linear-gradient(90deg,#ffd9b0,#ff5c8a)]" style="transform:scaleX(0)"></div>
              </div>
            </div>
            <div class="flex justify-between font-mono text-[0.68rem] text-white/50 tabular-nums">
              <span data-current>0:00</span>
              <span data-total>{fmt(first.duration)}</span>
            </div>

            <div class="mt-3 flex items-center justify-between md:mt-5">
              <button type="button" class="hidden size-10 items-center justify-center text-white/70 md:inline-flex" aria-label={demo.shuffle}>
                <Icon name="shuffle" size={18} />
              </button>
              <button type="button" data-prev class="inline-flex size-10 items-center justify-center text-white/90 transition hover:scale-105" aria-label={demo.prev}>
                <Icon name="skip-back-fill" size={22} />
              </button>
              <button
                type="button"
                data-play
                data-state="paused"
                data-label-play={demo.play}
                data-label-pause={demo.pause}
                aria-label={demo.play}
                class="play inline-flex size-14 items-center justify-center rounded-full bg-white text-ink-950 shadow-[0_10px_30px_-8px_rgb(0_0_0/0.6)] transition hover:scale-105 active:scale-95"
              >
                <Icon name="play-fill" size={24} class="icon-play translate-x-[1px]" />
                <Icon name="pause-fill" size={24} class="icon-pause" />
              </button>
              <button type="button" data-next class="inline-flex size-10 items-center justify-center text-white/90 transition hover:scale-105" aria-label={demo.next}>
                <Icon name="skip-forward-fill" size={22} />
              </button>
              <span class="hidden size-10 md:inline-flex" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div data-viewport role="group" class="demo-viewport relative h-full min-h-[22rem]" aria-label={t.lyrics.kicker}></div>
      </div>

      <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-between gap-4 px-5 pb-4 text-[0.7rem] text-white/45 sm:px-8 md:px-12">
        <span class="inline-flex items-center gap-2"><Icon name="sparkle" size={12} />{demo.note}</span>
        <span class="hidden sm:inline">{demo.hint}</span>
      </div>
    </div>
  </div>
</section>

<script>
  // AMLL (and pixi) only load once the demo is about to scroll into view.
  document.querySelectorAll<HTMLElement>('[data-lyrics-demo]').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        import('~/scripts/lyrics-player').then(({ mountLyricsDemo }) => mountLyricsDemo(el));
      },
      { rootMargin: '900px 0px' },
    );
    io.observe(el);
  });
</script>

<style>
  .lyrics-demo {
    height: clamp(40rem, 82vh, 46rem);
  }
  .demo-viewport {
    mask-image: linear-gradient(180deg, transparent 0%, #000 6%, #000 84%, transparent 100%);
  }
  .demo-viewport :global(.demo-lyrics) {
    --amll-lp-font-size: clamp(1.5rem, 2.7vw, 2.3rem);
    position: absolute;
    inset: 0;
    font-family: var(--font-sans);
    font-weight: 600;
  }
  [data-bg] :global(.demo-bg) {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out-quint);
  }
  [data-lyrics-demo][data-ready] [data-bg] :global(.demo-bg) {
    opacity: 1;
  }
  .demo-fallback {
    background:
      radial-gradient(60% 70% at 20% 30%, #b4471f 0%, transparent 70%),
      radial-gradient(60% 60% at 85% 70%, #7c2d3a 0%, transparent 70%),
      #3a160c;
  }
  .cover {
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.9s var(--ease-out-quint),
      transform 1.2s var(--ease-out-expo);
  }
  .cover[data-active] {
    opacity: 1;
    transform: none;
  }
  .play .icon-pause,
  .play[data-state='playing'] .icon-play {
    display: none;
  }
  .play[data-state='playing'] .icon-pause {
    display: block;
  }
</style>
