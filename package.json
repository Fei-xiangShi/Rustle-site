{
  "name": "rustle-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/subset-cjk-font.mjs && astro dev",
    "build": "node scripts/subset-cjk-font.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "assets": "node scripts/generate-assets.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:pages": "pnpm run build && wrangler pages deploy dist --project-name rustle-site",
    "preview:worker": "pnpm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/utils": "^3.1.7",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
